  "cards": [
    {
      "dot": "emerald",
      "title": "Fase Previa y Subprocesos Externos",
      "items": [
        "Paso 1-2: Planificación por curva de tallas y verificación integral de stock.",
        "Paso 3-4: Sublimación y corte gráfico de capelladas con proveedor textil.",
        "Paso 5-8: Cadena de corte de cuero y posterior fijación de pedrería."
      ]
    },
    {
      "dot": "cyan",
      "title": "Kit de Ensamble y Taller",
      "items": [
        "Paso 9-11: Consolidación de todos los componentes y ficha técnica visual.",
        "Paso 12-13: Entrega del paquete completo al taller para ensamblado del calzado."
      ]
    },
    {
      "dot": "rose",
      "title": "Control de Calidad y Cierre",
      "items": [
        "Paso 14-16: Filtro de calidad; reproceso en taller o registro de baja con rescate de materiales.",
        "Paso 17-18: Ingreso a bodega solo de pares conformes y embalaje comercial al despachar."
      ]
    }
  ]
}
