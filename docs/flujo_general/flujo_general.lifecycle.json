      "mode": "auto",
      "entries": {
        "start": { "label": "Inicio OP" },
        "active": { "label": "Proceso Interno / Ensamble" },
        "external": { "label": "Taller / Proveedor Externo" },
        "decision": { "label": "Control de Calidad" },
        "waiting": { "label": "Reparación / Subsanación" },
        "failure": { "label": "Baja / Pérdida Material" },
        "success": { "label": "Aprobado / Despacho Final" }
      }
    }
  },
  "mainPath": [
