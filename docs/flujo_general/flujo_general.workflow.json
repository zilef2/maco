  "cards": [
    {
      "dot": "cyan",
      "title": "Alistamiento y Procesos Satélite",
      "items": [
        "1-2. Planificación de tallas en OP y verificación de existencias en bodega.",
        "3-4. Envío de lonas y archivos de capellada para sublimación externa.",
        "5-8. Circuito satélite: corte de cuero en taller y fijación de pedrería."
      ]
    },
    {
      "dot": "emerald",
      "title": "Consolidación de Kit y Ensamble",
      "items": [
        "9-12. Armado del kit integral de materiales e impresión de ficha técnica con imagen.",
        "13. Entrega formal al taller para el ensamblado completo del calzado."
      ]
    },
    {
      "dot": "rose",
      "title": "Calidad, Reproceso y Despacho",
      "items": [
        "14-16. Recepción y control de calidad; reparación en taller o baja con recuperación.",
        "17-18. Ingreso a bodega solo de pares conformes y empaque de marca al despachar."
      ]
    }
  ]
