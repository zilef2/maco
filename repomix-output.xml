  <!-- Toolbar: theme, live visual style, trace motion, presentation stage, and export.
       Motion appears only for trace-enabled artifacts and has no shortcut;
       Keyboard: T toggles theme, S cycles style, F toggles the stage, E opens export. -->
  <div class="toolbar" role="toolbar" aria-label="Acciones del diagrama">
    <div class="toolbar-group">
    <button id="btn-theme" type="button"
            title="Cambiar tema (T)"
            aria-label="Cambiar tema de color"
            aria-pressed="false">
      <span id="theme-icon" class="toolbar-icon" aria-hidden="true"></span>
      <span id="theme-label">Oscuro</span>
    </button>
    <div class="preset-wrap">
      <button id="btn-preset" type="button"
              title="Elegir estilo visual (S alterna)"
              aria-label="Elegir estilo visual"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="preset-menu"
              aria-keyshortcuts="S">
        <span class="preset-control-mark" aria-hidden="true"></span>
        <span id="preset-label">Estilo</span>
        <span class="toolbar-icon toolbar-chevron" aria-hidden="true"></span>
      </button>
      <div class="preset-menu" id="preset-menu" role="menu" aria-label="Estilo visual">
        <div class="preset-menu-heading" role="presentation"><span>Identidad visual</span><span class="preset-menu-shortcut"><kbd>S</kbd>alterna</span></div>
        <button class="preset-option" data-preset-value="classic" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch classic" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Clásico</strong><small>Predeterminado técnico estable</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
        <button class="preset-option" data-preset-value="signal-flow" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch signal-flow" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Flujo de señal</strong><small>Presentación con énfasis en el movimiento</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
        <button class="preset-option" data-preset-value="blueprint" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch blueprint" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Plano</strong><small>Revisión de ingeniería</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
        <button class="preset-option" data-preset-value="editorial" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch editorial" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Editorial</strong><small>Notas de publicación y lanzamiento</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <button id="btn-motion" type="button" hidden
            title="Pausar animación"
            aria-label="Pausar animación"
            aria-pressed="true">
      <span class="motion-control-dot" aria-hidden="true"></span>
      <span id="motion-label">Activa</span>
    </button>
    <button id="btn-present" type="button"
            title="Modo presentación (F)"
            aria-label="Entrar al modo presentación"
            aria-pressed="false">
      <span id="present-icon" class="toolbar-icon" aria-hidden="true"></span>
      <span id="present-label">Presentar</span>
    </button>
    </div>
    <div class="export-wrap">
      <button id="btn-export" type="button"
              title="Exportar diagrama (E)"
              aria-label="Exportar diagrama"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="export-menu">
        Exportar <span class="toolbar-icon toolbar-chevron" aria-hidden="true"></span>
      </button>
      <div class="export-menu" id="export-menu" role="menu" aria-label="Exportar">
        <div class="export-menu-header" role="presentation">
          <div><strong>Exportar diagrama</strong><span>Salidas portables y limpias</span></div>
          <kbd>E</kbd>
        </div>
        <div class="export-menu-section" role="group" aria-label="Compartir">
          <span class="export-menu-heading" aria-hidden="true">Compartir</span>
          <button data-action="route-share-card" type="button" role="menuitem" tabindex="-1" hidden disabled><span class="export-item-copy"><strong>Tarjeta de ruta para compartir</strong><small class="hint">1200&times;630 PNG</small></span></button>
          <button data-action="reach-share-card" type="button" role="menuitem" tabindex="-1" hidden disabled><span class="export-item-copy"><strong>Tarjeta de alcance para compartir</strong><small class="hint">1200&times;630 PNG</small></span></button>
          <button data-action="copy" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>Copiar diagrama</strong><small class="hint">PNG al portapapeles</small></span></button>
        </div>
        <div class="export-menu-section" role="group" aria-label="Imágenes rasterizadas">
          <span class="export-menu-heading" aria-hidden="true">Imagen</span>
          <button data-format="png" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>PNG</strong><small class="hint">Imagen sin pérdida</small></span></button>
          <button data-format="jpeg" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>JPEG</strong><small class="hint">Imagen compacta</small></span></button>
          <button data-format="webp" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>WebP</strong><small class="hint">Imagen moderna</small></span></button>
        </div>
        <div class="export-menu-section" role="group" aria-label="Vector y movimiento">
          <span class="export-menu-heading" aria-hidden="true">Vector y movimiento</span>
          <button data-format="svg" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>SVG · Auto</strong><small class="hint">Coincide con el tema del host</small></span></button>
          <button data-format="svg-light" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>SVG · Claro</strong><small class="hint">Siempre claro</small></span></button>
          <button data-format="svg-dark" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>SVG · Oscuro</strong><small class="hint">Siempre oscuro</small></span></button>
          <button data-format="webm" type="button" role="menuitem" tabindex="-1"><span class="export-item-copy"><strong>WebM</strong><small class="hint">Movimiento de 6 s</small></span></button>
        </div>
      </div>
    </div>
  </div>

