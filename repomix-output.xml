                        :losSelect="props.losSelect" />

                    <Edit v-if="can(['update Distribucion_por_tallas'])" :titulos="titulos" :numberPermissions="props.numberPermissions"
                        :show="data.editOpen" @close="data.editOpen = false" :Distribucion_por_tallasa="data.Distribucion_por_tallaso"
                        :title="props.title" :losSelect="props.losSelect" />

                    <Delete v-if="can(['delete Distribucion_por_tallas'])" :numberPermissions="props.numberPermissions"
