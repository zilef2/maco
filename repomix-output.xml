});

const emit = defineEmits(["close"]);

const getInitialFormState = () => {
    const initialState: Record<string, any> = {
        nombre: 'Presupuesto',
        descripcion: 'Presupuesto para el semestre 2 del 2026',
        fecha_inicio: '2026-12-31',
        fecha_fin: '2027-12-31',
        monto_total: 5600000,
        monto_ejecutado: 0,
        monto_disponible: 5000000,
        total_salarios: 200000,
        total_viaticos: 200000,
        total_materiales: 100000,
