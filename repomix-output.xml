>>"%SALIDA%" echo  1. DEPENDENCIAS DECLARADAS (package.json)
>>"%SALIDA%" echo ------------------------------------------------------------
>>"%SALIDA%" echo.

if not exist "%PKG%" (
    >>"%SALIDA%" echo   [AVISO] No se encontro package.json en %PROYECTO%
    goto :seccion2
)

where node >nul 2>nul
if errorlevel 1 (
    >>"%SALIDA%" echo   [AVISO] Node no esta en PATH. Usando parseo simple.
    >>"%SALIDA%" echo.
    call :parse_simple
