                        :losSelect="props.losSelect" />

                    <Edit v-if="can(['update Producto'])" :titulos="titulos" :numberPermissions="props.numberPermissions"
                        :show="data.editOpen" @close="data.editOpen = false" :Productoa="data.Productoo"
