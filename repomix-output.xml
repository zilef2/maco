<file path="app/Models/CierreOrdenProduccion.php">
<?php

namespace App\Models;

use Illuminate\Support\Facades\DB;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

use Illuminate\Database\Eloquent\SoftDeletes;

    class CierreOrdenProduccion extends Model
{
    /** @use HasFactory<\Database\Factories\CierreOrdenProduccionFactory> */
    use HasFactory;
    protected $fillable = ['orden_produccion_id', 'control_cierre', 'dato_esperado', 'dato_real', 'diferencia', 'estado_accion', 'responsable_id', 'fecha_cierre', 'id', 'observaciones'];



    public static function getFillableWithTypes(): array
    {
        $table = (new static)->getTable();
        $columns = DB::select("SHOW COLUMNS FROM {$table}");

        $fillable = (new static)->getFillable();
        $result = [];

        foreach ($columns as $column) {
            if (! in_array($column->Field, $fillable) || $column->Field === 'id') {
                continue;
            }

            $type = 'text';
            if (str_contains($column->Type, 'foreign') || str_ends_with($column->Field, '_id')) {
                $type = 'foreign';
            } elseif (str_contains($column->Type, 'int')) {
                $type = 'integer';
            } elseif (str_contains($column->Type, 'decimal') || str_contains($column->Type, 'float')) {
                $type = 'dinero';
            } elseif (str_contains($column->Type, 'date') || str_contains($column->Type, 'datetime')) {
                $type = 'date';
            }

            $result[] = [
                'order' => $column->Field,
                'label' => $column->Field,
                'type' => $type,
            ];
        }

        return $result;
    }
}
</file>

<file path="app/Models/FichaTecnica.php">
<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsToMany;
use Illuminate\Database\Eloquent\Relations\HasMany;

class FichaTecnica extends Model
{
    /** @use HasFactory<\Database\Factories\FichaTecnicaFactory> */
    use HasFactory;

    protected $fillable = ['nombre'];

    protected $appends = ['valor_total_ficha'];

    public function materiales(): HasMany
    {
        return $this->hasMany(FichaTecnicaMateriales::class);
    }

    public function productos(): BelongsToMany
    {
        return $this->belongsToMany(Producto::class, 'ficha_tecnica_producto', 'ficha_tecnica_id', 'producto_id')->withTimestamps();
    }

    public function getValorTotalFichaAttribute(): float
    {
        if ($this->relationLoaded('materiales')) {
            return (float) $this->materiales->sum('costo_asociado_teorico');
        }
        return (float) $this->materiales()->sum('costo_asociado_teorico');
    }

    /**
     * Ids de productos que ya tienen ficha (excluyendo la ficha indicada).
     */
    public static function productosConFicha(array $productoIds, ?int $exceptoFichaId = null): array
    {
        return self::query()
            ->whereKeyNot($exceptoFichaId ?? 0)
            ->whereHas('productos', fn ($q) => $q->whereIn('producto_id', $productoIds))
            ->with('productos:id')
            ->get()
            ->flatMap(fn ($ficha) => $ficha->productos->pluck('id'))
            ->intersect($productoIds)
            ->values()
            ->all();
    }
}
</file>

