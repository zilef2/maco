      --flow-halo-peak: 0.17;
      --flow-glow-peak: 0.5;
      --flow-tail-peak: 0.42;
      --flow-head-peak: 0.95;
      --flow-wake-peak: 0.3;
      --flow-ripple-peak: 0.65;
