      filter: drop-shadow(0 0 11px var(--security-stroke));
    }
    svg[data-route-active] [data-route-step]:not([data-route-start]):not([data-route-end]) {
      filter: drop-shadow(0 0 7px var(--backend-stroke));
    }
    svg[data-route-journey] [data-route-match][data-route-journey-state="past"] { opacity: 0.62; }
    svg[data-route-journey] [data-route-match][data-route-journey-state="future"] { opacity: 0.34; }
    svg[data-route-journey] [data-route-match][data-route-journey-state="current"] { opacity: 1; }
    svg[data-route-journey] [data-graph-role="automatic-crossover"]:has(> [data-route-match][data-route-journey-state="past"]) > [data-graph-role="automatic-crossover-underlay"] { opacity: 0.62; }
    svg[data-route-journey] [data-graph-role="automatic-crossover"]:has(> [data-route-match][data-route-journey-state="future"]) > [data-graph-role="automatic-crossover-underlay"] { opacity: 0.34; }
    svg[data-route-journey] [data-graph-role="automatic-crossover"]:has(> [data-route-match][data-route-journey-state="current"]) > [data-graph-role="automatic-crossover-underlay"] { opacity: 1; }
    svg[data-route-journey] [data-node-id][data-route-journey-current] {
      filter: drop-shadow(0 0 10px var(--backend-stroke));
    }
    svg[data-route-journey] [data-edge-from][data-route-journey-current] {
      opacity: 1;
      filter: drop-shadow(0 0 6px var(--backend-stroke));
    }
    .route-probe-overlay { pointer-events: none; }
    .route-journey-overlay { pointer-events: none; }
    .route-probe-flow {
      fill: none;
      stroke: var(--backend-stroke);
      stroke-width: 3.25;
      stroke-linecap: round;
      stroke-dasharray: 0.085 0.915;
      stroke-dashoffset: 0;
      vector-effect: non-scaling-stroke;
      opacity: 0.96;
      filter: drop-shadow(0 0 5px var(--backend-stroke));
      animation: archify-route-probe-flow 1.1s cubic-bezier(0.22, 1, 0.36, 1) 1 both;
      animation-delay: calc(var(--route-step, 0) * 0.16s);
    }
    .route-journey-flow {
      fill: none;
      stroke: var(--backend-stroke);
      stroke-width: 3.5;
      stroke-linecap: round;
      stroke-dasharray: 0.1 0.9;
      stroke-dashoffset: 0;
      vector-effect: non-scaling-stroke;
      opacity: 0;
      filter: drop-shadow(0 0 6px var(--backend-stroke));
      animation: archify-route-journey-flow 780ms cubic-bezier(0.22, 1, 0.36, 1) 1 both;
    }
    svg[data-preset="blueprint"] [data-route-start],
    svg[data-preset="blueprint"] [data-route-end],
    svg[data-preset="blueprint"] [data-route-step],
    svg[data-preset="blueprint"] .route-probe-flow {
      filter: none;
      stroke-linecap: square;
    }
    svg[data-preset="blueprint"] .route-journey-flow {
      filter: none;
      stroke-linecap: square;
    }
    svg[data-preset="editorial"] [data-route-start],
    svg[data-preset="editorial"] [data-route-end],
    svg[data-preset="editorial"] [data-route-step],
    svg[data-preset="editorial"] .route-probe-flow,
    svg[data-preset="editorial"] .route-journey-flow { filter: none; }

    svg[data-preset="editorial"] .c-grid {
      stroke-dasharray: 1 4;
      opacity: 0.48;
    }
    svg[data-preset="editorial"] .c-region {
      fill: color-mix(in srgb, var(--cloud-fill) 48%, transparent);
      stroke-dasharray: 9 4;
    }
    svg[data-preset="editorial"] [data-node-id]:hover,
    svg[data-preset="editorial"] [data-node-id]:focus-visible,
    svg[data-preset="editorial"][data-focus-active] [data-focus-selected] {
      filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--text) 18%, transparent));
    }

    svg[data-preset="blueprint"] .c-grid {
      stroke-dasharray: 1 3;
      opacity: 0.78;
    }
    svg[data-preset="blueprint"] .c-region {
      fill: color-mix(in srgb, var(--cloud-fill) 58%, transparent);
      stroke-dasharray: 12 4 2 4;
    }
    svg[data-preset="blueprint"] .c-security-group,
    svg[data-preset="blueprint"] .c-lane { stroke-dasharray: 7 3; }
    svg[data-preset="blueprint"] [data-node-id]:hover,
    svg[data-preset="blueprint"] [data-node-id]:focus-visible {
      filter: drop-shadow(0 0 3px var(--frontend-stroke));
    }
    svg[data-preset="blueprint"][data-focus-active] [data-focus-selected] {
      filter: drop-shadow(0 0 3px var(--frontend-stroke));
    }
    svg[data-preset="blueprint"][data-focus-active][data-reach-active] [data-focus-selected][data-reach-origin] {
      filter: none;
    }
    svg[data-preset="blueprint"][data-relationship-preview-active] [data-relationship-preview],
    svg[data-preset="blueprint"][data-relationship-preview-active] [data-relationship-preview-source],
    svg[data-preset="blueprint"][data-relationship-preview-active] [data-relationship-preview-target] {
      filter: drop-shadow(0 0 3px var(--frontend-stroke));
    }

    /* Dashed boundary variants */
    .c-security-group { fill: transparent; stroke: var(--security-stroke); stroke-dasharray: 4,4; }
    .c-region         { fill: rgba(251, 191, 36, 0.05); stroke: var(--cloud-stroke); stroke-dasharray: 8,4; }
    .c-lane           { fill: var(--lane-fill); stroke: var(--lane-stroke); stroke-dasharray: 6,6; }

    /* Live plays one relay per cycle: a comet (halo, tail, head) leaves each
       source when the signal reaches it, travels at one shared speed, leaves a
       soft wake, and lands as a ripple while its target glows. Downstream edges
       depart only after their source is reached, so the reader sees the path the
       diagram describes rather than every edge shimmering at once. Sequence
       messages relay in authored chronological order. Motion Governor plans the
       timeline and its per-edge keyframes; this stylesheet owns appearance.
       Original line language and markers remain static. Node entry is bounded to
       one pass per document. */
    svg[data-animation="trace"] {
      --flow-cycle: 6.4s;
      --flow-halo-peak: 0.17;
      --flow-glow-peak: 0.5;
      --flow-tail-peak: 0.42;
      --flow-head-peak: 0.95;
      --flow-wake-peak: 0.3;
      --flow-ripple-peak: 0.65;
    }
    .ambient-edge-flow {
      fill: none;
      stroke: var(--arrow-emphasis);
      stroke-linecap: round;
      pointer-events: none;
      display: none;
    }
    .ambient-flow-wake {
      --flow-peak: var(--flow-wake-peak, 0.3);
      stroke-width: 3.2;
      stroke-dasharray: var(--flow-dasharray, none);
    }
    .ambient-flow-halo {
      --flow-peak: var(--flow-halo-peak, 0.17);
      stroke-width: 6;
      stroke-dasharray: var(--flow-dash, 12px) calc(var(--flow-len, 0px) - var(--flow-dash, 12px));
    }
    /* A wide blurred streak centered on the head: this is the bloom that makes
       the comet read as a traveling orb of light rather than a bright dash. */
    .ambient-flow-glow {
      --flow-peak: var(--flow-glow-peak, 0.5);
      stroke-width: 9;
      stroke-dasharray: var(--flow-dash, 12px) calc(var(--flow-len, 0px) - var(--flow-dash, 12px));
      filter: blur(2.5px);
    }
    .ambient-flow-tail {
      --flow-peak: var(--flow-tail-peak, 0.42);
      stroke-width: 2.4;
      stroke-dasharray: var(--flow-dasharray, var(--flow-dash, 20px) calc(var(--flow-len, 0px) - var(--flow-dash, 20px)));
    }
    .ambient-flow-head {
      --flow-peak: var(--flow-head-peak, 0.95);
      stroke: color-mix(in srgb, var(--arrow-emphasis) 40%, white);
      stroke-width: 2.6;
      stroke-dasharray: var(--flow-dash, 6px) calc(var(--flow-len, 0px) - var(--flow-dash, 6px));
    }
    .ambient-flow-ripple {
      --flow-peak: var(--flow-ripple-peak, 0.65);
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, white);
      stroke-width: 2;
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden]) .ambient-edge-flow {
      display: inline;
      animation-name: var(--flow-name, none);
      animation-duration: var(--flow-cycle, 6.4s);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-delay: var(--flow-delay, 0s);
      /* Without backwards fill a delayed layer would sit at its natural opacity
         (fully lit) until its departure arrives. */
      animation-fill-mode: backwards;
    }
    /* Stream packets trail the comet head as smaller, dimmer beads. */
    .ambient-flow-head.packet {
      --flow-peak: calc(var(--flow-head-peak, 0.95) * 0.62);
      stroke-width: 3.4;
    }
    /* Timeline and waterfall playhead: a crisp rule over a soft bloom. */
    .ambient-flow-playhead {
      --flow-peak: 0.9;
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, white);
      stroke-width: 1.6;
    }
    .ambient-flow-playhead-glow {
      --flow-peak: 0.32;
      stroke-width: 10;
      filter: blur(4px);
    }
    /* Waterfall spans fill in proportion to their measured time, then settle. */
    .ambient-flow-fill {
      --flow-peak: 0.5;
      fill: color-mix(in srgb, var(--flow-fill, var(--arrow-emphasis)) 55%, white);
      stroke: none;
      transform-box: fill-box;
      transform-origin: left center;
    }
    .ambient-flow-fill-failed { fill: var(--security-stroke); --flow-peak: 0.5; }
    html[data-theme="light"] .ambient-flow-playhead { stroke: color-mix(in srgb, var(--arrow-emphasis) 70%, black); }
    html[data-theme="light"] .ambient-flow-fill { --flow-peak: 0.42; fill: color-mix(in srgb, var(--flow-fill, var(--arrow-emphasis)) 70%, black); }
    svg[data-preset="editorial"] .ambient-flow-fill { --flow-peak: 0.2; }
    svg[data-preset="editorial"] .ambient-flow-playhead-glow { --flow-peak: 0.14; }
    /* Each decorative flow follows its owning edge through tree visibility. */
    .ambient-edge-flow[data-tree-hidden] { display: none !important; animation: none !important; }
    svg[data-preset="blueprint"] .ambient-edge-flow { stroke-linecap: square; }
    svg[data-preset="editorial"] { --flow-halo-peak: 0.07; --flow-glow-peak: 0.28; --flow-tail-peak: 0.2; --flow-head-peak: 0.7; --flow-wake-peak: 0.14; --flow-ripple-peak: 0.3; }
    /* On light canvases the relay reads by saturation instead of bloom: the head
       and ripple mix toward ink instead of white, and every layer's peak rises so
       the wave survives the bright background. */
    html[data-theme="light"] svg[data-animation="trace"] {
      --flow-halo-peak: 0.22;
      --flow-glow-peak: 0.4;
      --flow-tail-peak: 0.5;
      --flow-wake-peak: 0.34;
    }
    html[data-theme="light"] .ambient-flow-head {
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, black);
      stroke-width: 2.8;
    }
    html[data-theme="light"] .ambient-flow-ripple {
      stroke: color-mix(in srgb, var(--arrow-emphasis) 65%, black);
    }
    html[data-ambient-entry="running"] svg[data-animation="trace"] [data-animate="node"] {
      transform-box: fill-box;
      transform-origin: center;
      animation: archify-node-pulse 3.6s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-entry="running"] svg[data-preset="signal-flow"][data-animation="trace"] [data-animate="node"] {
      animation: archify-node-pulse 3.1s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-entry="running"] svg[data-preset="blueprint"][data-animation="trace"] [data-animate="node"] {
      animation: archify-blueprint-node-pulse 3.8s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-entry="running"] svg[data-preset="editorial"][data-animation="trace"] [data-animate="node"] {
      animation: archify-editorial-node-pulse 3.5s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    /* Each node glows in its planned windows: when the relay reaches it, while a
       walk token rests on it, as a message lands, or as the playhead passes.
       During the bounded entrance all three animations run; the entrance pulse is
       listed after the repeating glow and wins on filter until it completes. */
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden]) svg[data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite;
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
        archify-node-pulse 3.6s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-preset="signal-flow"][data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
        archify-node-pulse 3.1s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-preset="blueprint"][data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
        archify-blueprint-node-pulse 3.8s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-preset="editorial"][data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
        archify-editorial-node-pulse 3.5s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    @keyframes archify-node-enter {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @media print {
      .ambient-edge-flow { display: none !important; animation: none !important; }
      svg[data-animation="trace"] [data-animate="node"] { animation: none !important; }
    }
    @keyframes archify-node-pulse {
      0%, 72%, 100% { filter: none; stroke-width: 1.5; }
      18%, 36% {
        filter: drop-shadow(0 0 8px var(--arrow-emphasis));
        stroke-width: 2.4;
      }
    }
    @keyframes archify-blueprint-node-pulse {
      0%, 72%, 100% { opacity: 1; filter: none; }
      18%, 36% { opacity: 0.72; filter: drop-shadow(0 0 2px var(--frontend-stroke)); }
    }
    @keyframes archify-editorial-node-pulse {
      0%, 72%, 100% { opacity: 1; filter: none; }
      18%, 36% { opacity: 0.78; filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--text) 18%, transparent)); }
    }
    @keyframes archify-signal-scan {
      0%, 18% { opacity: 1; transform: translateX(-70%); }
      70% { opacity: 1; transform: translateX(70%); }
      100% { opacity: 0; transform: translateX(70%); }
    }
    @keyframes archify-radar-live {
      0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--backend-stroke) 52%, transparent); }
      55%, 100% { box-shadow: 0 0 0 0.32rem transparent; }
    }

    @keyframes archify-intent-trace-flow {
      0% { opacity: 0.28; stroke-dashoffset: 0; }
      12%, 78% { opacity: 0.94; }
      100% { opacity: 0; stroke-dashoffset: -1; }
    }
    @keyframes archify-route-probe-flow {
      0% { stroke-dashoffset: 0; opacity: 0.96; }
      78% { stroke-dashoffset: -1; opacity: 0.96; }
      100% { stroke-dasharray: none; stroke-dashoffset: 0; opacity: 0.58; }
    }
    @keyframes archify-route-journey-flow {
      0% { opacity: 0.16; stroke-dashoffset: 0; }
      14%, 76% { opacity: 1; }
      100% { opacity: 0; stroke-dashoffset: -1; }
    }
    @keyframes archify-semantic-lens-flow {
      0% { opacity: 0.2; stroke-dashoffset: 0; }
      12%, 78% { opacity: 0.9; }
      100% { opacity: 0; stroke-dashoffset: -1; }
    }
    @keyframes archify-relationship-pulse {
      0% { opacity: 0.18; stroke-dashoffset: 0; }
      10%, 76% { opacity: 0.98; }
      100% { opacity: 0; stroke-dashoffset: -1; }
    }
    @keyframes archify-relationship-token-life {
      0%, 7% { opacity: 0; }
      13%, 82% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes archify-share-cue-enter {
      from { opacity: 0; transform: translate(-50%, -0.45rem); }
      to { opacity: 1; transform: translate(-50%, 0); }
    }
    @keyframes archify-share-cue-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.48; transform: scale(0.78); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ambient-edge-flow { display: none !important; animation: none !important; }
      html[data-preset="signal-flow"] .diagram-container::before {
        animation: none !important;
      }
      .pulse-dot { animation: none !important; }
      .motion-control-dot { animation: none !important; }
      svg[data-animation="trace"] [data-animate] {
        animation: none !important;
        stroke-dashoffset: 0;
      }
      svg[data-animation="trace"] [data-graph-role="automatic-crossover"]:has(> [data-animate="edge"]) > [data-graph-role="automatic-crossover-underlay"] {
        animation: none !important;
        stroke-dashoffset: 0;
      }
      .intent-trace-flow,
      .route-probe-flow,
      .semantic-lens,
      .diagram-guide,
      .overview-map-live { animation: none !important; }
      
      .intent-trace-flow {
        animation: none !important;
        stroke-dasharray: none;
        stroke-dashoffset: 0;
        opacity: 0.72;
      }
      .route-probe-flow {
        animation: none !important;
        stroke-dasharray: none;
        stroke-dashoffset: 0;
        opacity: 0.78;
      }
      .route-journey-overlay { display: none !important; }
      .semantic-lens-flow {
        animation: none !important;
        stroke-dasharray: none;
        stroke-width: 2.2;
        opacity: 0.34;
        filter: none;
      }
      .relationship-pulse-overlay { display: none !important; }
      svg [data-node-id], svg [data-edge-from], svg [data-detail], svg [data-detail-anchor], svg [data-legend-hit], svg { transition: none !important; }
    }
  </style>
</head>
<body>
  <!-- Toolbar: theme, live visual style, trace motion, presentation stage, and export.
       Motion appears only for trace-enabled artifacts and has no shortcut;
       Keyboard: T toggles theme, S cycles style, F toggles the stage, E opens export. -->
  <div class="toolbar" role="toolbar" aria-label="Diagram actions">
    <div class="toolbar-group">
    <button id="btn-theme" type="button"
            title="Toggle theme (T)"
            aria-label="Toggle color theme"
            aria-pressed="false">
      <span id="theme-icon" class="toolbar-icon" aria-hidden="true"></span>
      <span id="theme-label">Dark</span>
    </button>
    <div class="preset-wrap">
      <button id="btn-preset" type="button"
              title="Choose visual style (S cycles)"
              aria-label="Choose visual style"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="preset-menu"
              aria-keyshortcuts="S">
        <span class="preset-control-mark" aria-hidden="true"></span>
        <span id="preset-label">Style</span>
        <span class="toolbar-icon toolbar-chevron" aria-hidden="true"></span>
      </button>
      <div class="preset-menu" id="preset-menu" role="menu" aria-label="Visual style">
        <div class="preset-menu-heading" role="presentation"><span>Visual identity</span><span class="preset-menu-shortcut"><kbd>S</kbd>to cycle</span></div>
        <button class="preset-option" data-preset-value="classic" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch classic" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Classic</strong><small>Stable technical default</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
        <button class="preset-option" data-preset-value="signal-flow" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch signal-flow" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Signal Flow</strong><small>Motion-forward presentation</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
        <button class="preset-option" data-preset-value="blueprint" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch blueprint" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Blueprint</strong><small>Engineering review</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
        <button class="preset-option" data-preset-value="editorial" type="button" role="menuitemradio" aria-checked="false" tabindex="-1">
          <span class="preset-option-swatch editorial" aria-hidden="true"></span>
          <span class="preset-option-copy"><strong>Editorial</strong><small>Publication and launch notes</small></span>
          <span class="preset-option-check" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <button id="btn-motion" type="button" hidden
            title="Pause motion"
            aria-label="Pause motion"
            aria-pressed="true">
      <span class="motion-control-dot" aria-hidden="true"></span>
      <span id="motion-label">Live</span>
    </button>
    <button id="btn-present" type="button"
            title="Presentation stage (F)"
            aria-label="Enter presentation stage"
            aria-pressed="false">
      <span id="present-icon" class="toolbar-icon" aria-hidden="true"></span>
      <span id="present-label">Present</span>
    </button>
    </div>
    <div class="export-wrap">
      <button id="btn-export" type="button"
