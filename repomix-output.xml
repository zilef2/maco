        routePanel.removeAttribute('data-guide-open');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-label', viewerText('viewer.guide.open'));
        feedback.textContent = '';
        if (options.restoreFocus !== false) {
