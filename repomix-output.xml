        <div class="space-y-4">
            <div class="px-4 sm:px-0">
                <div class="rounded-lg overflow-hidden w-fit">
                    <PrimaryButton class="m-1" @click="data.createOpen = true" v-if="can(['create CierreOrdenProduccion'])">
                        {{ lang().t('app.button.add') }}
                    </PrimaryButton>

                    <Create v-if="can(['create CierreOrdenProduccion'])" :numberPermissions="props.numberPermissions"
                        :titulos="titulos" :show="data.createOpen" @close="data.createOpen = false" :title="props.title"
                        :losSelect="props.losSelect" />

                    <Edit v-if="can(['update CierreOrdenProduccion'])" :titulos="titulos" :numberPermissions="props.numberPermissions"
                        :show="data.editOpen" @close="data.editOpen = false" :CierreOrdenProducciona="data.CierreOrdenProducciono"
                        :title="props.title" :losSelect="props.losSelect" />

                    <Delete v-if="can(['delete CierreOrdenProduccion'])" :numberPermissions="props.numberPermissions"
                        :show="data.deleteOpen" @close="data.deleteOpen = false" :CierreOrdenProducciona="data.CierreOrdenProducciono"
                        :title="props.title" />
                </div>
            </div>
            <div class="relative bg-white dark:bg-gray-800 shadow sm:rounded-lg w-max min-w-full">
                <div class="flex justify-between p-2">
                    <div class="flex space-x-2">
                        <SelectInput v-model="data.params.perPage" :dataSet="data.dataSet" />
                    </div>
                    <TextInput v-if="props.numberPermissions && props.numberPermissions > 1"
