    material_origen_id: '',
    cantidad_salida: '',
    unidad_medida: '',
    bodega_origen: '',
    proveedor_destino_id: '',
    servicio_proceso: '',
    fecha_salida: '',
    fecha_prevista_regreso: '',
    resultado_observaciones: '',
    fecha_regreso_real: '',
});

const aFechaHora = (valor: any) => {
    if (!valor) {
        return '';
    }
    let v = String(valor).replace('T', ' ');
    if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}$/.test(v)) {
        v += ':00';
    }
    return v;
};

const closeModal = () => {
    emit("close");
    form.reset();
};

const create = () => {
    form.transform((data: any) => ({
        ...data,
        fecha_salida: aFechaHora(data.fecha_salida),
        fecha_regreso_real: aFechaHora(data.fecha_regreso_real),
    })).post(route('ProcesoExterno.store'), {
        preserveScroll: true,
        onSuccess: () => {
            closeModal();
        },
        onError: () => null,
        onFinish: () => null,
    });
};

watchEffect(() => {
    if (props.show) {
        form.errors = {};
    }
});
