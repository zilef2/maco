                        </div>

                        <div>
                            <InputLabel for="servicio_proceso_pe" value="Servicio / proceso" />
                            <TextInput id="servicio_proceso_pe" type="text" class="mt-1 block w-full h-10 px-3"
                                v-model="form.servicio_proceso" placeholder="Ej: sublimación" />
