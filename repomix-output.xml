import Create from '@/pages/CierreOrdenProduccion/Create.vue';
import Edit from '@/pages/CierreOrdenProduccion/Edit.vue';
import Delete from '@/pages/CierreOrdenProduccion/Delete.vue';

import Checkbox from '@/components/Checkbox.vue';
import InfoButton from '@/components/InfoButton.vue';

import { formatDate, zilef_nuber_format } from '@/global.ts';

const { _, debounce, pickBy } = pkg
const props = defineProps({
    fromController: Object,
    total: Number,
    filters: Object,
    breadcrumbs: Object,
    perPage: Number,

    title: String,

    numberPermissions: Number,
    losSelect: Object,
    titulos: Array,
})

const defaultPerPage = [
    { label: '5', value: 5 },
    { label: '10', value: 10 },
    { label: '25', value: 25 },
    { label: '50', value: 50 },
    { label: '100', value: 100 },
];

const data = reactive({
    params: {
        search: props.filters?.search,
        field: props.filters?.field,
        order: props.filters?.order,
        perPage: props.perPage,
    },
    CierreOrdenProducciono: null as any,
    selectedId: [] as number[],
    multipleSelect: false,
    createOpen: false,
    editOpen: false,
    deleteOpen: false,
    dataSet: (usePage().props as any)?.app?.perpage ?? defaultPerPage,
})

const order = (field: string) => {
    data.params.field = field
    data.params.order = data.params.order === "asc" ? "desc" : "asc"
}

watch(() => _.cloneDeep(data.params), debounce(() => {
    const params = pickBy(data.params)
    router.get(route("CierreOrdenProduccion.index"), params, {
        replace: true,
        preserveState: true,
        preserveScroll: true,
    })
}, 150))

const selectAll = (event: any) => {
    if (event.target.checked === false) {
        data.selectedId = []
    } else {
        props.fromController?.data.forEach((CierreOrdenProduccion: any) => {
            data.selectedId.push(CierreOrdenProduccion.id)
        })
    }
}
const select = () => data.multipleSelect = props.fromController?.data.length === data.selectedId.length;

const titulos = [
    { order: 'orden_produccion_id', label: 'orden_produccion_id', type: 'foreign' },
    { order: 'control_cierre', label: 'control_cierre', type: 'string' },
    { order: 'dato_esperado', label: 'dato_esperado', type: 'number' },
    { order: 'dato_real', label: 'dato_real', type: 'number' },
    { order: 'diferencia', label: 'diferencia', type: 'number' },
    { order: 'estado_accion', label: 'estado_accion', type: 'string' },
    { order: 'responsable_id', label: 'responsable_id', type: 'foreign' },
    { order: 'fecha_cierre', label: 'fecha_cierre', type: 'datetime' },
    { order: 'id', label: 'id', type: 'string' },
    { order: 'observaciones', label: 'observaciones', type: 'text' },
];

</script>

<template>

