<script setup lang="ts">
import Modal from '@/components/Modal.vue';
import SecondaryButton from '@/components/SecondaryButton.vue';
import { formatDate } from '@/global.ts';
import axios from 'axios';
import { reactive, watch } from 'vue';

const props = defineProps({
    show: Boolean,
    material: {
        type: Object,
        default: null,
    },
});

const emit = defineEmits(['close']);

const state = reactive({
    loading: false,
    movimientos: [] as any[],
    error: '',
});

const cargarMovimientos = async () => {
    if (!props.material?.id) return;

    state.loading = true;
    state.error = '';
    try {
        const response = await axios.get(route('Material.movimientos', props.material.id));
        const res = response.data?.movimientos;
        state.movimientos = Array.isArray(res) ? res : (res?.data ?? []);
    } catch {
        state.error = 'No fue posible cargar el historial.';
    } finally {
        state.loading = false;
    }
};

watch(
    () => props.show,
    (isOpen) => {
        if (isOpen && props.material) {
            cargarMovimientos();
        } else {
            state.movimientos = [];
        }
    }
);
</script>

<template>
    <section class="space-y-6">
        <Modal :show="props.show" @close="emit('close')" :maxWidth="'xl3'">
