    /* ==========================================================
       SVG SEMANTIC CLASSES — use these instead of inline fill/stroke
       ========================================================== */
    .c-grid       { stroke: var(--grid); fill: none; }
    .c-mask       { fill: var(--mask); stroke: none; }
    .c-lane-rule  { stroke: var(--lane-stroke); fill: none; opacity: 0.7; }
    .c-lane-wash  { fill: var(--lane-fill); stroke: none; }

    .c-frontend   { fill: var(--frontend-fill);   stroke: var(--frontend-stroke); }
    .c-backend    { fill: var(--backend-fill);    stroke: var(--backend-stroke); }
    .c-database   { fill: var(--database-fill);   stroke: var(--database-stroke); }
    .c-cloud      { fill: var(--cloud-fill);      stroke: var(--cloud-stroke); }
    .c-security   { fill: var(--security-fill);   stroke: var(--security-stroke); }
    .c-messagebus { fill: var(--messagebus-fill); stroke: var(--messagebus-stroke); }
    .c-external   { fill: var(--external-fill);   stroke: var(--external-stroke); }

    /* Text helpers */
    .t-primary { fill: var(--text); }
    .t-muted   { fill: var(--text-muted); }
    .t-dim     { fill: var(--text-dim); }
    .t-frontend   { fill: var(--frontend-stroke); }
    .t-backend    { fill: var(--backend-stroke); }
    .t-database   { fill: var(--database-stroke); }
    .t-cloud      { fill: var(--cloud-stroke); }
    .t-security   { fill: var(--security-stroke); }
    .t-messagebus { fill: var(--messagebus-stroke); }
    .t-external   { fill: var(--external-stroke); }

    /* Relationship labels share the exact color token used by their path. */
    .t-edge-default  { fill: var(--arrow); }
    .t-edge-emphasis { fill: var(--arrow-emphasis); }
    .t-edge-security { fill: var(--security-stroke); }
    .t-edge-dashed   { fill: var(--database-stroke); }

    /* Classic canvas: a quiet dot field replaces drafting grid lines, and nodes
       read as lifted cards with hairline strokes. Paint only; authored geometry,
       hit areas and exports keep their canonical shapes. */
    html[data-preset="classic"] .diagram-container {
      background:
        radial-gradient(circle at 1px 1px, var(--canvas-dot) 1px, transparent 1.4px) 0 0 / 20px 20px,
        var(--panel);
    }
    html[data-preset="classic"] .diagram-container > svg .c-grid { stroke: transparent; }
    html[data-preset="classic"][data-theme="light"] .diagram-container > svg [data-node-id] > rect:not(.c-mask) {
      --ambient-node-base-filter: drop-shadow(0 1px 1px rgba(17, 24, 39, 0.05)) drop-shadow(0 6px 12px rgba(17, 24, 39, 0.06));
      filter: var(--ambient-node-base-filter);
    }
    html[data-preset="classic"][data-theme="dark"] .diagram-container > svg [data-node-id] > rect:not(.c-mask) {
      --ambient-node-base-filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.35));
      filter: var(--ambient-node-base-filter);
    }
    html[data-preset="classic"] .diagram-container > svg [data-edge-from] {
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    html[data-preset="classic"] .diagram-container > svg .c-lane-wash { fill: color-mix(in srgb, var(--text) 2.6%, transparent); }
    html[data-preset="classic"] .diagram-container > svg .c-lane-rule { stroke: var(--panel-border); opacity: 1; }
    html[data-preset="classic"][data-theme="dark"] .diagram-container > svg .c-lane-rule { stroke: rgba(148, 163, 184, 0.16); }
    html[data-preset="classic"] .diagram-container > svg [data-node-id] {
      transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
    }
    html[data-preset="classic"]:not([data-motion="still"]) .diagram-container > svg [data-node-id]:hover {
      transform: translateY(-1.5px);
    }

    /* Semantic Sigils are small authored role stamps, not icons from a brand
       pack and not viewer controls. Prefix selectors with svg so the canonical
       export's SVG-only stylesheet collector keeps them automatically. */
    svg .semantic-sigil {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.35;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.76;
      pointer-events: none;
    }
    svg .semantic-sigil > * { vector-effect: non-scaling-stroke; }
    svg .semantic-sigil .sigil-fill { fill: currentColor; stroke: none; }
