const props = defineProps({
    show: Boolean,
    title: String,
    roles: Object,
    titulos: Object, //parametros de la clase principal
    losSelect: Object,
    numberPermissions: Number,
})
const emit = defineEmits(["close"]);

const data = reactive({
    params: {
        pregunta: ''
    },
})

//very usefull
const justNames = props.titulos.map(names => {
    if (names['order'] !== 'fecha_cotizacion'
        && names['order'] !== 'fecha_cotizacion_aceptada'
        && names['order'] !== 'estado'
    )
        return names['order']
})
const form = useForm({
    ...Object.fromEntries(justNames.map(field => [field, ''])),
});
onMounted(() => {

});

const printForm = [];
props.titulos.forEach(names => { //aqui van los que no se ven en el formulario
    if (names['order'] !== 'fecha_cotizacion'
        && names['order'] !== 'fecha_cotizacion_aceptada'
        && names['order'] !== 'estado'
    )
        printForm.push({
            idd: names['order'], label: names['label'], type: names['type']
        })
});

function ValidarVacios() {
    let result = true
    printForm.forEach(element => {
        const valor = form[element.idd];

        if (valor === 0 || valor === "0") {
            return result
        } 
        
        if (valor === null || valor === undefined || valor === "") {
            console.log("=>(Create.vue:70) falta esto papa element.idd", element.idd);
            result = false
            return result
        }
    });
    return result
}

const create = () => {
    if (ValidarVacios()) {
        // console.log("🧈 debu pieza_id:", form.pieza_id);
        form.post(route('desarrollo.store'), {
            preserveScroll: true,
            onSuccess: () => {
                emit("close")
                form.reset()
            },
            onError: () => null,
            onFinish: () => null,
        })
    } else {
        console.log('Hay campos vacios')
    }
}

watch(() => form.valor_inicial, (newValor) => {
    const newval = parseInt(newValor);
    form.valor_parcial1 = newval / 2;
});

watchEffect(() => {
    if (props.show) {
        form.errors = {}

        if (props.numberPermissions > 9) {

            setTimeout(() => {
                // const valueRAn = Math.floor(Math.random() * (9) + 1)
                form.nombre = 'Cotización nueva funcion ';
                const hoy = new Date()
                form.fecha_reunion = Date_to_html(hoy)
                form.valor_inicial = 0
            }, 350);
        }
    }
})


// const sexos = [{ label: 'Masculino', value: 0 }, { label: 'Femenino', value: 1 }];

const estados = [
    'Cotizando',
    'Desarrollando',
    'Esperando pago parcial',
    'Pagada totalmente',
    'Finalizada'
];
</script>

