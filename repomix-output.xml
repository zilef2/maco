<script setup lang="ts">
import AppLayout from '@/layouts/AppLayout.vue';
import { Head, router, usePage } from '@inertiajs/vue3';
import Breadcrumb from '@/components/Breadcrumb.vue';
import TextInput from '@/components/TextInput.vue';
import PrimaryButton from '@/components/PrimaryButton.vue';
import SelectInput from '@/components/SelectInput.vue';
import { reactive, computed, watch } from 'vue';

import DangerButton from '@/components/DangerButton.vue';
import pkg from 'lodash';

import Pagination from '@/components/Pagination.vue';
import { ChevronUpDownIcon, PencilIcon, TrashIcon, ArrowUpTrayIcon, ArrowsRightLeftIcon, ClockIcon, CheckCircleIcon, FunnelIcon } from '@heroicons/vue/24/solid';
import Create from '@/pages/Material/Create.vue';
import Edit from '@/pages/Material/Edit.vue';
import Delete from '@/pages/Material/Delete.vue';
import ImportarMaterialModal from '@/pages/Material/ImportarMaterialModal.vue';
import AlterarExistencia from '@/pages/Material/AlterarExistencia.vue';
import HistorialMovimientos from '@/pages/Material/HistorialMovimientos.vue';
import HistorialMultiples from '@/pages/Material/HistorialMultiples.vue';

import Checkbox from '@/components/Checkbox.vue';
import InfoButton from '@/components/InfoButton.vue';

import { formatDate, zilef_nuber_format } from '@/global.ts';

const { _, debounce, pickBy } = pkg
const props = defineProps({
    fromController: Object,
    total: Number,
    filters: Object,
    breadcrumbs: Object,
    perPage: Number,

    title: String,

    numberPermissions: Number,
    losSelect: Object,
    titulos: Array,
})

const defaultPerPage = [
    { label: '5', value: 5 },
    { label: '10', value: 10 },
    { label: '25', value: 25 },
    { label: '50', value: 50 },
    { label: '100', value: 100 },
];

const titulosVisibles = computed(() => props.titulos?.filter((t) => t.order !== 'unidad_inventario') ?? []);

// Un filtro por cada columna de la tabla.
// tipo: 'texto' | 'numero' | 'booleano' | 'proveedor'
const filtrosColumna = [
    { campo: 'codigo_material', label: 'Código', tipo: 'texto' },
    { campo: 'categoria', label: 'Categoría', tipo: 'texto' },
    { campo: 'nombre_base', label: 'Nombre base', tipo: 'texto' },
    { campo: 'unidad_inventario', label: 'Unidad', tipo: 'texto' },
    { campo: 'existencia_actual', label: 'Existencia', tipo: 'numero' },
    { campo: 'maneja_color', label: 'Maneja color', tipo: 'booleano' },
    { campo: 'maneja_talla', label: 'Maneja talla', tipo: 'booleano' },
    { campo: 'maneja_otra_variante', label: 'Otra variante', tipo: 'booleano' },
    { campo: 'estado', label: 'Estado', tipo: 'texto' },
    { campo: 'variante_atributo_sugerido', label: 'Variante', tipo: 'texto' },
    { campo: 'proveedor_habitual', label: 'Proveedor', tipo: 'proveedor' },
    { campo: 'material_procesado', label: 'Procesado', tipo: 'booleano' },
    { campo: 'observaciones', label: 'Observaciones', tipo: 'texto' },
];

const opcionesBooleano = [
    { value: '', label: 'Todos' },
    { value: '1', label: 'Sí' },
    { value: '0', label: 'No' },
];

const opcionesProveedor = computed(() => [
    { value: '', label: 'Todos' },
    ...(props.losSelect?.proveedor_habitual ?? []),
]);

const data = reactive({
    params: {
        search: props.filters?.search,
        field: props.filters?.field,
        order: props.filters?.order,
        perPage: props.perPage,
        ...Object.fromEntries(filtrosColumna.map((f) => [f.campo, props.filters?.[f.campo] ?? ''])),
    },
    Materialo: null as any,
    selectedId: [] as number[],
    multipleSelect: false,
    createOpen: false,
    editOpen: false,
    deleteOpen: false,
    importOpen: false,
    alterarExistenciaOpen: false,
    historialOpen: false,
    historialMultipleOpen: false,
    historialMateriales: [] as any[],
    mostrarFiltros: true,
    dataSet: (usePage().props as any)?.app?.perpage ?? defaultPerPage,
})

const order = (field: string) => {
    data.params.field = field
    data.params.order = data.params.order === "asc" ? "desc" : "asc"
}

watch(() => _.cloneDeep(data.params), debounce(() => {
    const params = pickBy(data.params)
    router.get(route("Material.index"), params, {
        replace: true,
        preserveState: true,
        preserveScroll: true,
    })
}, 150))

const selectAll = (event: any) => {
    if (event.target.checked === false) {
        data.selectedId = []
    } else {
        props.fromController?.data.forEach((Material: any) => {
            data.selectedId.push(Material.id)
        })
    }
}
const select = () => data.multipleSelect = props.fromController?.data.length === data.selectedId.length;

// Historial de varios materiales: activo solo con 1 a 3 seleccionados
const MAX_HISTORIAL_MULTIPLE = 3;
const puedeHistorialMultiple = computed(
    () => data.selectedId.length >= 1 && data.selectedId.length <= MAX_HISTORIAL_MULTIPLE
);

const abrirHistorialMultiple = () => {
    if (!puedeHistorialMultiple.value) return;
    data.historialMateriales = (props.fromController?.data ?? []).filter((m: any) =>
        data.selectedId.includes(m.id)
    );
    data.historialMultipleOpen = true;
};

const titulos = [
    { order: 'codigo_material', label: 'codigo_material', type: 'string' },
    { order: 'categoria', label: 'categoria', type: 'string' },
    { order: 'nombre_base', label: 'nombre_base', type: 'string' },
    { order: 'unidad_inventario', label: 'unidad_inventario', type: 'string' },
    { order: 'existencia_actual', label: 'existencia_actual', type: 'dinero' },
    { order: 'maneja_color', label: 'maneja_color', type: 'boolean' },
    { order: 'maneja_talla', label: 'maneja_talla', type: 'boolean' },
    { order: 'maneja_otra_variante', label: 'maneja_otra_variante', type: 'boolean' },
    { order: 'estado', label: 'estado', type: 'string' },
    { order: 'variante_atributo_sugerido', label: 'variante_atributo_sugerido', type: 'string' },
    { order: 'proveedor_habitual', label: 'proveedor_habitual', type: 'foreign', nameid: 'proveedor_nombre' },
    { order: 'material_procesado', label: 'material_procesado', type: 'integer' },
    { order: 'observaciones', label: 'observaciones', type: 'string' },
];

const filtrosActivos = computed(
    () => filtrosColumna.filter((f) => data.params[f.campo] !== '' && data.params[f.campo] != null).length
);

const limpiarFiltros = () => {
    filtrosColumna.forEach((f) => {
        data.params[f.campo] = '';
    });
};

</script>

<template>

    <Head :title="props.title" />

    <AppLayout>
        <Breadcrumb :title="title" :breadcrumbs="breadcrumbs" class="capitalize text-xl font-bold" />
        <div class="space-y-4">
            <div class="px-4 sm:px-0">
                <div class="rounded-lg overflow-hidden w-fit">
                    <PrimaryButton class="m-1 align-top" @click="data.createOpen = true" v-if="can(['create Material'])">
                        {{ lang().t('app.button.add') }}
                    </PrimaryButton>

                    <PrimaryButton v-if="can(['create Material'])"
                        class="m-1 align-top bg-emerald-600 hover:bg-emerald-700 focus:ring-emerald-500"
                        @click="data.importOpen = true">
                        <ArrowUpTrayIcon class="w-4 h-4 mr-1 inline" />
                        Cargar Excel
                    </PrimaryButton>

                    <PrimaryButton v-if="can(['read Material'])"
                        class="m-1 align-top bg-indigo-600 hover:bg-indigo-700 focus:ring-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed"
                        :disabled="!puedeHistorialMultiple"
                        v-tooltip="data.selectedId.length > MAX_HISTORIAL_MULTIPLE
                            ? `Máximo ${MAX_HISTORIAL_MULTIPLE} materiales`
                            : 'Ver historial de los materiales seleccionados'"
                        @click="abrirHistorialMultiple">
                        <ClockIcon class="w-4 h-4 mr-1 inline" />
                        Ver historial{{ data.selectedId.length ? ` (${data.selectedId.length})` : '' }}
                    </PrimaryButton>

                    <HistorialMultiples :show="data.historialMultipleOpen"
                        :materiales="data.historialMateriales"
                        @close="data.historialMultipleOpen = false" />

                    <ImportarMaterialModal :show="data.importOpen" @close="data.importOpen = false" />

                    <Create v-if="can(['create Material'])" :numberPermissions="props.numberPermissions"
                        :titulos="titulos" :show="data.createOpen" @close="data.createOpen = false" :title="props.title"
                        :losSelect="props.losSelect" />

                    <Edit v-if="can(['update Material'])" :titulos="titulos" :numberPermissions="props.numberPermissions"
                        :show="data.editOpen" @close="data.editOpen = false" :Materiala="data.Materialo"
                        :title="props.title" :losSelect="props.losSelect" />

                    <Delete v-if="can(['delete Material'])" :numberPermissions="props.numberPermissions"
                        :show="data.deleteOpen" @close="data.deleteOpen = false" :Materiala="data.Materialo"
                        :title="props.title" />

                    <AlterarExistencia v-if="can(['update Material'])"
                        :show="data.alterarExistenciaOpen"
                        :material="data.Materialo"
                        @close="data.alterarExistenciaOpen = false" />

                    <HistorialMovimientos v-if="can(['read Material'])"
                        :show="data.historialOpen"
                        :material="data.Materialo"
                        @close="data.historialOpen = false" />
                </div>
            </div>
            <div class="relative bg-white dark:bg-gray-800 shadow sm:rounded-lg w-max min-w-full">
                <div class="flex justify-between p-2">
                    <div class="flex space-x-2 items-center">
                        <SelectInput v-model="data.params.perPage" :dataSet="data.dataSet" />
                        <button type="button" @click="data.mostrarFiltros = !data.mostrarFiltros"
                            class="inline-flex items-center gap-1 rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                            <FunnelIcon class="w-4 h-4" />
                            Filtros
                            <span v-if="filtrosActivos"
                                class="ml-1 inline-flex items-center rounded-full bg-primary px-2 py-0.5 text-xs font-semibold text-white">
                                {{ filtrosActivos }}
                            </span>
                        </button>
                        <button v-if="filtrosActivos" type="button" @click="limpiarFiltros"
                            class="rounded-md px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20">
                            Limpiar
                        </button>
                    </div>
                    <TextInput v-if="props.numberPermissions && props.numberPermissions > 1"
                        v-model="data.params.search" type="text" class="block w-4/6 md:w-3/6 lg:w-2/6 rounded-lg"
                        :placeholder="lang().t('app.placeholder.search')" />
                </div>
                <div v-if="data.mostrarFiltros"
                    class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 px-2 pb-3 border-b border-gray-200 dark:border-gray-700">
                    <div v-for="filtro in filtrosColumna" :key="filtro.campo" class="flex flex-col gap-1">
                        <label class="text-xs font-medium text-gray-500 dark:text-gray-400">{{ filtro.label }}</label>
                        <SelectInput v-if="filtro.tipo === 'booleano'" v-model="data.params[filtro.campo]"
                            :dataSet="opcionesBooleano"
                            class="w-full text-sm rounded-md" />
                        <SelectInput v-else-if="filtro.tipo === 'proveedor'" v-model="data.params[filtro.campo]"
                            :dataSet="opcionesProveedor"
                            class="w-full text-sm rounded-md" />
                        <TextInput v-else :type="filtro.tipo === 'numero' ? 'number' : 'text'"
                            v-model="data.params[filtro.campo]"
                            class="w-full text-sm rounded-md block"
                            :placeholder="filtro.label" />
                    </div>
                </div>
                <div>
                    <table v-if="props.total && props.total > 0" class="w-full">
                        <thead class="uppercase text-sm border-t border-gray-200 dark:border-gray-700">
                            <tr class="dark:bg-gray-900/50 text-left">
                                <th class="px-2 py-4 text-center">
                                    <Checkbox v-model:checked="data.multipleSelect" @change="selectAll" />
                                </th>
                                <th v-if="props.numberPermissions && props.numberPermissions > 1" class="px-2 py-4">
                                    Accion</th>

                                <th class="px-2 py-4 text-center">#</th>
                                <th v-for="titulo in titulosVisibles" :key="titulo.order" class="px-2 py-4 cursor-pointer"
                                    v-on:click="order(titulo['order'])">
                                    <div class="flex justify-between items-center">
                                        <span>{{ lang().t('app.label.' + titulo['label']) }}</span>
                                        <ChevronUpDownIcon class="w-4 h-4" />
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(claseFromController, indexu) in props.fromController?.data" :key="indexu"
                                class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-200/30 hover:dark:bg-gray-900/20">

                                <td class="whitespace-nowrap py-4 px-2 sm:py-3 text-center">
                                    <input
                                        class="rounded dark:bg-gray-900 border-gray-300 dark:border-gray-700 text-primary dark:text-primary shadow-sm focus:ring-primary/80 dark:focus:ring-primary dark:focus:ring-offset-gray-800 dark:checked:bg-primary dark:checked:border-primary"
                                        type="checkbox" @change="select" :value="claseFromController.id"
                                        v-model="data.selectedId" />
                                </td>
                                <td v-if="props.numberPermissions && props.numberPermissions > 1"
                                    class="whitespace-nowrap py-4 w-12 px-2 sm:py-3">
                                    <div class="flex justify-center items-center">
