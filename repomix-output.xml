        umbral_alerta: 0,
        fecha_ultimo_reajuste: '2026-12-31',
        motivo_reajuste: 'No hay reajustes',
    };

    if (props.titulos && Array.isArray(props.titulos)) {
        props.titulos.forEach((item) => {
            if (item.order && item.default !== undefined) {
                initialState[item.order] = item.default;
            }
        });
    }
    return initialState;
};

const form = useForm(getInitialFormState());

const state = reactive({
    validationError: false,
});

function validarVacios(): boolean {
    let isValid = true;
    if (props.titulos && Array.isArray(props.titulos)) {
        props.titulos.forEach((item) => {
            const val = (form as any)[item.order];
            if (!item.optional && (val === '' || val === null || val === undefined)) {
                console.log("Campo obligatorio vacío:", item.order);
                isValid = false;
            }
        });
    }
    return isValid;
}

const create = () => {
    if (validarVacios()) {
        state.validationError = false;
        form.post(route('Presupuesto.store'), {
            preserveScroll: true,
            onSuccess: () => {
                emit("close");
                form.reset();
            },
        });
    } else {
        state.validationError = true;
